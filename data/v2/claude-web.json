{
  "id": "claude-web",
  "headerCard": {
    "variant": "info",
    "icon": "stars",
    "title": "Requires laptop for setup",
    "html": "Works everywhere once connected."
  },
  "steps": [
    {
      "type": "step",
      "n": 1,
      "html": "Download and open Claude Desktop App from <b>claude.ai/download</b>",
      "image": "assets/guides/quick/v2/claude-web/step-1.png"
    },
    {
      "type": "step",
      "n": 2,
      "html": "Click <b>Customize</b> in the left sidebar",
      "image": "assets/guides/quick/v2/claude-web/step-2.png"
    },
    {
      "type": "step",
      "n": 3,
      "html": "Select <b>Connectors</b> from the top menu",
      "image": "assets/guides/quick/v2/claude-web/step-3.png"
    },
    {
      "type": "step",
      "n": 4,
      "html": "Search for “NeoSapien”",
      "image": "assets/guides/quick/v2/claude-web/step-4.png"
    },
    {
      "type": "step",
      "n": 5,
      "html": "Open the NeoSapien Plugin",
      "image": "assets/guides/quick/v2/claude-web/step-5.png"
    },
    {
      "type": "step",
      "n": 6,
      "html": "Click <b>“Add”</b>",
      "image": "assets/guides/quick/v2/claude-web/step-6.png"
    },
    {
      "type": "step",
      "n": 7,
      "html": "Sign in with your NeoSapien account (may differ from your ChatGPT account)",
      "image": "assets/guides/quick/v2/claude-web/step-7.png"
    },
    {
      "type": "step",
      "n": 8,
      "html": "Open chat, enable NeoSapien &amp; try your first prompt: “<span class=\"grad\">What do you know about me from Neosapien?</span>”",
      "image": "assets/guides/quick/v2/claude-web/step-8.png"
    },
    {
      "type": "step",
      "n": 9,
      "html": "Congrats NeoSapien is now connected to Claude.",
      "image": "assets/guides/quick/v2/claude-web/step-9.png"
    }
  ]
}